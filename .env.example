# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# For SQLite (default, development):
# DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/shidosha_db
# For MySQL:
# DATABASE_URL=mysql://user:password@localhost:3306/shidosha_db

# CORS Settings (for frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Mentor Configuration (REQUIRED)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_MENTOR_MODEL=claude-3-5-sonnet-20241022
AI_MENTOR_MAX_TOKENS=2000
AI_MENTOR_TEMPERATURE=0.7

# Shidosha Feature Flags
ENABLE_AI_MENTOR=True
ENABLE_GAMIFICATION=True

# Email Settings (optional, for notifications)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password

# Sentry (optional, for error tracking)
# SENTRY_DSN=your-sentry-dsn-here
